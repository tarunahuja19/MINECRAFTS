+// Numeric limit for `condition` at a given `level` ('ADVISORY'/'WARNING'/
+// 'CRITICAL' -- 'NORMAL' has no limit and returns null). Shared by
+// `classify()`'s own rung comparisons and by `backend/alarm/engine.js`,
+// which needs the limit of a level on its own (e.g. to compute a deadband
+// boundary) rather than a classification. Reuses `ppvBand` so the PPV
+// frequency-band lookup lives in exactly one place.
+function limitFor(condition, level, ctx = {}) {
+  if (level === 'NORMAL') return null;
+  const freqHz = ctx.freqHz === undefined ? null : ctx.freqHz;
+  const table = load();
+  const conditions = table.conditions;
+  if (!Object.prototype.hasOwnProperty.call(conditions, condition)) {
+    throw new Error(`unknown alarm condition: ${condition}`);
+  }
+  const spec = conditions[condition];
+  const key = level.toLowerCase();
+  if (condition === 'ppv') {
+    const band = ppvBand(spec, freqHz);
+    const frac = spec.fractions[key];
+    return frac === null || frac === undefined ? null : frac * band.limit;
+  }
+  const limit = spec[key];
+  return limit === undefined ? null : limit;
+}
